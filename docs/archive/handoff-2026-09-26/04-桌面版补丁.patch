@@ -0,0 +1,33 @@
+# 桌面/单机版配置（profile: standalone）
+#
+# 特点：不依赖外部 MySQL —— 用 H2 文件库，数据落在用户目录下；前端构建产物由本服务直接提供。
+# 启动方式见打包产物中的启动器，或：
+#   java -jar timetable-backend-1.0.0.jar --spring.profiles.active=standalone
+
+spring:
+  datasource:
+    # H2 文件库。~ 由 H2 展开为 user.home；启动器会传入 %LOCALAPPDATA% 下的绝对路径（正斜杠）。
+    # AUTO_SERVER 允许多个连接共享同一库，避免上次异常退出后残留锁文件导致「Database may be already in use」。
+    url: jdbc:h2:file:${app.data-dir}/timetable;MODE=MySQL;DATABASE_TO_LOWER=TRUE;AUTO_SERVER=TRUE
+    driver-class-name: org.h2.Driver
+    username: sa
+    password: ""
+  sql:
+    init:
+      mode: always
+      # H2 与 MySQL 的三处语义差异见 schema-h2.sql 头部说明
+      schema-locations: classpath:db/schema-h2.sql
+      data-locations: classpath:db/data.sql
+
+# 本机专用端口：避开常见的 8080，减少与其它软件冲突的概率
+server:
+  port: ${TANGENT_PORT:17817}
+
+app:
+  # 数据目录（H2 库文件与本地设置都放这里）
+  data-dir: ${TANGENT_DATA_DIR:~/.tangent-timetable}
+  # 桌面版首次启动不写死任何账号，由 ApiKeyBootstrap 生成随机 Key 并打印
+
+logging:
+  file:
+    name: ${app.data-dir}/logs/timetable.log
diff --git a/backend/src/main/resources/db/schema-h2.sql b/backend/src/main/resources/db/schema-h2.sql
new file mode 100644
index 0000000..fd8d567
--- /dev/null
+++ b/backend/src/main/resources/db/schema-h2.sql
@@ -0,0 +1,142 @@
+-- H2 专用建表脚本（standalone / 桌面版使用；MySQL 版见 schema.sql）
+--
+-- 与 schema.sql 的三处差异，全部因为 H2 与 MySQL 的语义不同：
+--   1) H2 的索引名是「全库唯一」，MySQL 只在表内唯一 → schedule 与 todo 的 idx_api_key 分别改名
+--   2) H2 的 JSON 列会把字符串参数存成 JSON 字符串标量，读回带外层引号，
+--      导致 MyBatis-Plus 的 JacksonTypeHandler 解析失败 → weeks / action_data 改用文本列
+--   3) UNIQUE KEY 是 MySQL 语法 → 改用标准 CONSTRAINT ... UNIQUE
+-- 修改 schema.sql 时请同步本文件。
+CREATE TABLE IF NOT EXISTS api_key (
+    api_key VARCHAR(64) PRIMARY KEY,
+    label VARCHAR(50) NOT NULL,
+    avatar_url VARCHAR(500),
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
+);
+
+CREATE TABLE IF NOT EXISTS schedule (
+    id BIGINT PRIMARY KEY AUTO_INCREMENT,
+    api_key VARCHAR(64) NOT NULL,
+    name VARCHAR(100) NOT NULL,
+    period_start_date DATE NOT NULL,
+    period_end_date DATE NOT NULL,
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+    FOREIGN KEY (api_key) REFERENCES api_key(api_key) ON DELETE CASCADE,
+    INDEX idx_schedule_api_key (api_key)
+);
+
+CREATE TABLE IF NOT EXISTS period_config (
+    period_number TINYINT PRIMARY KEY,
+    start_time TIME NOT NULL,
+    end_time TIME NOT NULL,
+    category VARCHAR(10) NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS course (
+    id BIGINT PRIMARY KEY AUTO_INCREMENT,
+    schedule_id BIGINT NOT NULL,
+    name VARCHAR(200) NOT NULL,
+    location VARCHAR(200),
+    teacher VARCHAR(100),
+    day_of_week TINYINT NOT NULL,
+    start_period TINYINT NOT NULL,
+    end_period TINYINT NOT NULL,
+    weeks VARCHAR(1000) NOT NULL,
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+    FOREIGN KEY (schedule_id) REFERENCES schedule(id) ON DELETE CASCADE,
+    INDEX idx_schedule_day (schedule_id, day_of_week)
+);
+
+CREATE TABLE IF NOT EXISTS exam (
+    id BIGINT PRIMARY KEY AUTO_INCREMENT,
+    schedule_id BIGINT NOT NULL,
+    name VARCHAR(200) NOT NULL,
+    location VARCHAR(200),
+    exam_date DATE NOT NULL,
+    start_time TIME NOT NULL,
+    end_time TIME NOT NULL,
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+    FOREIGN KEY (schedule_id) REFERENCES schedule(id) ON DELETE CASCADE,
+    INDEX idx_exam_schedule (schedule_id)
+);
+
+CREATE TABLE IF NOT EXISTS todo (
+    id BIGINT PRIMARY KEY AUTO_INCREMENT,
+    api_key VARCHAR(64) NOT NULL,
+    title VARCHAR(500) NOT NULL,
+    ddl DATETIME NOT NULL,
+    completed BOOLEAN DEFAULT FALSE,
+    recurring_id BIGINT,
+    exam_id BIGINT,
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+    FOREIGN KEY (api_key) REFERENCES api_key(api_key) ON DELETE CASCADE,
+    INDEX idx_todo_api_key (api_key),
+    INDEX idx_ddl (ddl),
+    INDEX idx_completed (completed),
+    INDEX idx_todo_recurring (recurring_id),
+    INDEX idx_todo_exam (exam_id),
+    -- 同一循环规则同一次触发只能有一条待办。应用层已用条件更新原子占位，
+    -- 这条唯一键是多实例/异常路径下的兜底（recurring_id 为 NULL 的手工待办不受影响）。
+    CONSTRAINT uk_todo_recurring_ddl UNIQUE (recurring_id, ddl)
+);
+
+CREATE TABLE IF NOT EXISTS ai_conversation (
+    id BIGINT PRIMARY KEY AUTO_INCREMENT,
+    api_key VARCHAR(64) NOT NULL,
+    schedule_id BIGINT,
+    title VARCHAR(200),
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+    FOREIGN KEY (api_key) REFERENCES api_key(api_key) ON DELETE CASCADE,
+    INDEX idx_ai_conv_api_key (api_key)
+);
+
+CREATE TABLE IF NOT EXISTS ai_message (
+    id BIGINT PRIMARY KEY AUTO_INCREMENT,
+    conversation_id BIGINT NOT NULL,
+    role VARCHAR(16) NOT NULL,
+    content TEXT,
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    FOREIGN KEY (conversation_id) REFERENCES ai_conversation(id) ON DELETE CASCADE,
+    INDEX idx_ai_msg_conv (conversation_id)
+);
+
+CREATE TABLE IF NOT EXISTS ai_action (
+    id BIGINT PRIMARY KEY AUTO_INCREMENT,
+    message_id BIGINT NOT NULL,
+    api_key VARCHAR(64) NOT NULL,
+    scope VARCHAR(16) NOT NULL,
+    action_type VARCHAR(32) NOT NULL,
+    action_status VARCHAR(16) NOT NULL,
+    action_data TEXT,
+    data_fingerprint VARCHAR(64),
+    sort_order INT NOT NULL DEFAULT 0,
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    FOREIGN KEY (message_id) REFERENCES ai_message(id) ON DELETE CASCADE,
+    INDEX idx_ai_action_msg (message_id),
+    INDEX idx_ai_action_pending (api_key, scope, action_status)
+);
+
+CREATE TABLE IF NOT EXISTS recurring_todo (
+    id BIGINT PRIMARY KEY AUTO_INCREMENT,
+    api_key VARCHAR(64) NOT NULL,
+    title VARCHAR(500) NOT NULL,
+    frequency VARCHAR(16) NOT NULL,
+    day_of_week TINYINT,
+    day_of_month TINYINT,
+    trigger_time TIME,
+    script TEXT,
+    ddl_offset_minutes INT NOT NULL,
+    enabled BOOLEAN NOT NULL DEFAULT TRUE,
+    chain_after_complete BOOLEAN NOT NULL DEFAULT FALSE,
+    last_triggered_at DATETIME,
+    next_trigger_at DATETIME,
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+    FOREIGN KEY (api_key) REFERENCES api_key(api_key) ON DELETE CASCADE,
+    INDEX idx_recurring_api_key (api_key),
+    INDEX idx_recurring_next (enabled, next_trigger_at)
+);
diff --git a/desktop/build-desktop.ps1 b/desktop/build-desktop.ps1
new file mode 100644
index 0000000..5cb84a6
--- /dev/null
+++ b/desktop/build-desktop.ps1
@@ -0,0 +1,171 @@
+﻿<#
+.SYNOPSIS
+    构建「大切课程表」Windows 免安装桌面版。
+
+.DESCRIPTION
+    一条命令完成：前端构建 → 打包含前端的 Spring Boot fat jar → jlink 裁剪 JRE →
+    下载/解出 WebView2 SDK → 用系统自带 csc 编译 WinForms+WebView2 外壳 → 组装免安装目录。
+
+    产物是一个可直接拷走运行的目录（默认 <仓库>/desktop/app-image/TangentTimetable），
+    零外部依赖：不需要用户安装 Java、Node 或数据库。
+
+.PARAMETER OutputDir
+    输出目录。默认 <脚本目录>\app-image。
+
+.PARAMETER SkipWebView2Download
+    复用已解出的 WebView2 SDK（位于 %TEMP%\webview2-sdk\extract）而不重新下载。
+
+.EXAMPLE
+    powershell -ExecutionPolicy Bypass -File desktop\build-desktop.ps1
+#>
+[CmdletBinding()]
+param(
+    [string]$OutputDir,
+    [switch]$SkipWebView2Download
+)
+
+$ErrorActionPreference = 'Stop'
+
+$desktopDir = $PSScriptRoot
+$repoRoot   = Split-Path $desktopDir -Parent
+$backend    = Join-Path $repoRoot 'backend'
+$frontend   = Join-Path $repoRoot 'frontend'
+$shellDir   = Join-Path $desktopDir 'shell'
+if (-not $OutputDir) { $OutputDir = Join-Path $desktopDir 'app-image' }
+$dist = Join-Path $OutputDir 'TangentTimetable'
+
+# H2 之外还需要这些 JDK 模块：Spring Boot 用到 sql/naming/net.http/management，
+# Rhino 与 Jackson 用到 unsupported/compiler，jdk.zipfs 供 H2/资源读取。
+$jlinkModules = @(
+    'java.base', 'java.compiler', 'java.desktop', 'java.instrument', 'java.management',
+    'java.naming', 'java.net.http', 'java.prefs', 'java.rmi', 'java.scripting',
+    'java.security.jgss', 'java.sql', 'java.transaction.xa', 'java.xml',
+    'jdk.crypto.ec', 'jdk.unsupported', 'jdk.jfr', 'jdk.zipfs'
+) -join ','
+
+function Write-Step($text) { Write-Host "`n=== $text ===" -ForegroundColor Cyan }
+
+# ---------- 0. 前置检查 ----------
+Write-Step '0/7 前置检查'
+
+$javaHome = (Get-Command java -ErrorAction SilentlyContinue).Source
+if (-not $javaHome) { throw '未找到 java，请先安装 JDK 17+。' }
+$javaHome = Split-Path (Split-Path $javaHome -Parent) -Parent
+$jlink = Join-Path $javaHome 'bin\jlink.exe'
+if (-not (Test-Path $jlink)) { throw "未找到 jlink：$jlink（需要完整 JDK，而非仅 JRE）" }
+
+$csc = Join-Path $env:WINDIR 'Microsoft.NET\Framework64\v4.0.30319\csc.exe'
+if (-not (Test-Path $csc)) { throw "未找到 .NET Framework 编译器：$csc" }
+
+$webView2Runtime = Get-ItemProperty 'HKLM:\SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}' -ErrorAction SilentlyContinue
+if (-not $webView2Runtime) {
+    Write-Warning '未检测到 WebView2 Runtime。目标机器若也没有，需要先安装（Win10/11 通常自带）。'
+}
+
+Write-Host "JDK   : $javaHome"
+Write-Host "csc   : $csc"
+Write-Host "输出  : $dist"
+
+# ---------- 1. 前端 ----------
+Write-Step '1/7 构建前端（vite build）'
+Push-Location $frontend
+try {
+    if (-not (Test-Path (Join-Path $frontend 'node_modules'))) { & npm install }
+    & npm run build
+    if ($LASTEXITCODE -ne 0) { throw '前端构建失败' }
+} finally { Pop-Location }
+
+# ---------- 2. 含前端的 fat jar ----------
+Write-Step '2/7 打包后端（-Pstandalone：前端产物并入 jar + H2 运行时依赖）'
+Push-Location $backend
+try {
+    & .\mvnw.cmd -q -B -ntp package -Pstandalone -DskipTests
+    if ($LASTEXITCODE -ne 0) { throw '后端打包失败' }
+} finally { Pop-Location }
+$jar = Join-Path $backend 'target\timetable-backend-1.0.0.jar'
+if (-not (Test-Path $jar)) { throw "未生成 $jar" }
+
+# ---------- 3. jlink ----------
+Write-Step '3/7 jlink 裁剪运行时'
+if (Test-Path $dist) { Remove-Item $dist -Recurse -Force }
+New-Item -ItemType Directory -Force -Path (Join-Path $dist 'app') | Out-Null
+& $jlink --add-modules $jlinkModules --strip-debug --no-header-files --no-man-pages `
+    --compress=zip-6 --output (Join-Path $dist 'runtime')
+if ($LASTEXITCODE -ne 0) { throw 'jlink 失败' }
+Copy-Item $jar (Join-Path $dist 'app\timetable-backend.jar') -Force
+
+# ---------- 4. WebView2 SDK ----------
+Write-Step '4/7 准备 WebView2 SDK（仅编译期需要 net462 的程序集与原生 Loader）'
+$sdkRoot = Join-Path $env:TEMP 'webview2-sdk'
+$extract = Join-Path $sdkRoot 'extract'
+if ($SkipWebView2Download -and (Test-Path (Join-Path $extract 'lib\net462'))) {
+    Write-Host "复用已解出的 SDK：$extract"
+} else {
+    New-Item -ItemType Directory -Force -Path $sdkRoot | Out-Null
+    $index = Invoke-RestMethod 'https://api.nuget.org/v3-flatcontainer/microsoft.web.webview2/index.json'
+    $version = ($index.versions | Where-Object { $_ -notmatch '-' })[-1]
+    $nupkg = Join-Path $sdkRoot 'webview2.nupkg'
+    $url = "https://api.nuget.org/v3-flatcontainer/microsoft.web.webview2/$version/microsoft.web.webview2.$version.nupkg"
+    Write-Host "下载 Microsoft.Web.WebView2 $version"
+    Invoke-WebRequest $url -OutFile $nupkg
+    if (Test-Path $extract) { Remove-Item $extract -Recurse -Force }
+    # 用 .NET 解压：Expand-Archive 只接受 .zip 扩展名，而 nupkg 本身就是 zip
+    Add-Type -AssemblyName System.IO.Compression.FileSystem
+    [System.IO.Compression.ZipFile]::ExtractToDirectory($nupkg, $extract)
+}
+Copy-Item (Join-Path $extract 'lib\net462\Microsoft.Web.WebView2.Core.dll') $dist -Force
+Copy-Item (Join-Path $extract 'lib\net462\Microsoft.Web.WebView2.WinForms.dll') $dist -Force
+Copy-Item (Join-Path $extract 'runtimes\win-x64\native\WebView2Loader.dll') $dist -Force
+
+# ---------- 5. 外壳 ----------
+Write-Step '5/7 编译桌面外壳（WinForms + WebView2，用 .NET Framework 自带 csc）'
+$icon = Join-Path $shellDir 'app.ico'
+$cscArgs = @(
+    '/nologo', '/target:winexe', '/platform:x64', '/optimize+',
+    "/out:$dist\TangentTimetable.exe",
+    '/reference:System.dll', '/reference:System.Drawing.dll',
+    '/reference:System.Windows.Forms.dll', '/reference:System.Core.dll',
+    "/reference:$dist\Microsoft.Web.WebView2.Core.dll",
+    "/reference:$dist\Microsoft.Web.WebView2.WinForms.dll"
+)
+if (Test-Path $icon) { $cscArgs += "/win32icon:$icon" }
+$cscArgs += (Join-Path $shellDir 'Program.cs')
+& $csc @cscArgs
+if ($LASTEXITCODE -ne 0) { throw '外壳编译失败' }
+
+# ---------- 6. 汇总 ----------
+Write-Step '6/7 体积汇总'
+$total = (Get-ChildItem $dist -Recurse -File | Measure-Object Length -Sum).Sum
+Get-ChildItem $dist | ForEach-Object {
+    if ($_.PSIsContainer) {
+        $size = (Get-ChildItem $_.FullName -Recurse -File | Measure-Object Length -Sum).Sum
+        '{0,-40} {1,8:N1} MB' -f ($_.Name + '\'), ($size / 1MB)
+    } else {
+        '{0,-40} {1,8:N0} KB' -f $_.Name, ($_.Length / 1KB)
+    }
+}
+'{0,-40} {1,8:N1} MB' -f '合计', ($total / 1MB)
+
+# ---------- 7. 冒烟 ----------
+Write-Step '7/7 冒烟：启动外壳，等内置后端就绪，再关窗'
+$proc = Start-Process -FilePath (Join-Path $dist 'TangentTimetable.exe') -PassThru
+$ready = $false
+for ($i = 1; $i -le 90; $i++) {
+    Start-Sleep -Seconds 1
+    if (Get-NetTCPConnection -LocalPort 17817 -State Listen -ErrorAction SilentlyContinue) { $ready = $true; break }
+    if ($proc.HasExited) { break }
+}
+if ($ready) {
+    Write-Host '内置后端已就绪，窗口已打开 ✓' -ForegroundColor Green
+    Start-Sleep -Seconds 3
+    $proc.CloseMainWindow() | Out-Null
+    Start-Sleep -Seconds 3
+    $left = @(Get-Process javaw -ErrorAction SilentlyContinue).Count
+    if ($left -eq 0) { Write-Host '关窗后后端已一并退出 ✓' -ForegroundColor Green }
+    else { Write-Warning "关窗后仍有 $left 个 javaw 进程" }
+} else {
+    Write-Warning '冒烟未通过：内置后端未在 90 秒内就绪，请查看 %LOCALAPPDATA%\TangentTimetable\logs\timetable.log'
+}
+
+Write-Host "`n完成。产物目录：$dist" -ForegroundColor Green
+Write-Host '整个目录拷到任何 Windows 10/11 x64 机器即可双击运行（无需 Java / Node / 数据库）。'
diff --git a/desktop/shell/Program.cs b/desktop/shell/Program.cs
new file mode 100644
index 0000000..e5222ea
--- /dev/null
+++ b/desktop/shell/Program.cs
@@ -0,0 +1,403 @@
+// 大切课程表 —— Windows 桌面外壳（.NET Framework 4.8 + WebView2）
+//
+// 职责：
+//   1. 单实例：已有实例在跑就直接提示退出
+//   2. 本机账号：首次运行生成一个随机 API Key 存在数据目录，之后自动登录，用户无需手输
+//   3. 启动内置后端（jlink 裁剪运行时 + Spring Boot fat jar），数据落在 %LOCALAPPDATA%
+//   4. 用 WebView2 打开界面（无地址栏，就是桌面应用的样子）
+//   5. 关窗时结束后端进程；并用 Job Object 保证外壳异常退出时子进程也被系统回收
+//
+// 为什么外壳要管账号：应用本身没有注册页，账号是 api_key 表里的一行，服务端在表为空时
+// 会随机生成并只打印到日志 —— 桌面用户看不到日志。所以外壳自己生成 Key、持久化、并注入
+// WebView 的 localStorage 实现自动登录；首次运行时把 Key 显示出来，便于在其它设备使用。
+//
+// 编译：csc /target:winexe /platform:x64（见 build-desktop.ps1）
+// 注意：本文件必须保持 C# 5 语法 —— 只能用 .NET Framework 自带的 csc（它不认 C# 6+）。
+
+using System;
+using System.Diagnostics;
+using System.Drawing;
+using System.IO;
+using System.Net;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using System.Windows.Forms;
+using Microsoft.Web.WebView2.Core;
+using Microsoft.Web.WebView2.WinForms;
+
+namespace TangentTimetable
+{
+    internal static class Program
+    {
+        internal const int Port = 17817;
+        private const string MutexName = "TangentTimetable.SingleInstance.v1";
+
+        [STAThread]
+        private static void Main()
+        {
+            bool createdNew;
+            using (Mutex mutex = new Mutex(true, MutexName, out createdNew))
+            {
+                if (!createdNew)
+                {
+                    MessageBox.Show("大切课程表已经在运行了。", "大切课程表",
+                        MessageBoxButtons.OK, MessageBoxIcon.Information);
+                    return;
+                }
+                Application.EnableVisualStyles();
+                Application.SetCompatibleTextRenderingDefault(false);
+                Application.Run(new MainForm());
+                GC.KeepAlive(mutex);
+            }
+        }
+    }
+
+    internal sealed class MainForm : Form
+    {
+        private readonly WebView2 webView = new WebView2();
+        private readonly string dataDir;
+        private string keyFile;
+        private string accountKey;
+        private bool freshAccount;
+        private Process backend;
+        private bool ownsBackend;
+        private JobObject job;
+
+        internal MainForm()
+        {
+            this.Text = "大切课程表";
+            this.Width = 1180;
+            this.Height = 820;
+            this.MinimumSize = new Size(760, 560);
+            this.StartPosition = FormStartPosition.CenterScreen;
+            this.webView.Dock = DockStyle.Fill;
+            this.Controls.Add(this.webView);
+
+            this.dataDir = Path.Combine(
+                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+                "TangentTimetable");
+        }
+
+        protected override void OnLoad(EventArgs e)
+        {
+            base.OnLoad(e);
+            try
+            {
+                Directory.CreateDirectory(dataDir);
+                EnsureAccountKey();
+                StartBackendIfNeeded();
+            }
+            catch (Exception ex)
+            {
+                MessageBox.Show(ex.Message, "大切课程表 - 启动失败",
+                    MessageBoxButtons.OK, MessageBoxIcon.Error);
+                Close();
+                return;
+            }
+            InitWebView();
+        }
+
+        /// <summary>
+        /// 读取（或首次生成）本机账号 Key。生成后立即落盘，避免中途崩溃导致账号丢失。
+        /// 始终把该 Key 作为 bootstrap-key 传给后端：即使数据库被清空，
+        /// 也会用同一个 Key 重建账号，用户不会突然被锁在外面。
+        /// </summary>
+        private void EnsureAccountKey()
+        {
+            keyFile = Path.Combine(dataDir, "desktop-key.txt");
+            if (File.Exists(keyFile))
+            {
+                accountKey = File.ReadAllText(keyFile).Trim();
+            }
+            if (accountKey == null || accountKey.Length == 0)
+            {
+                accountKey = GenerateKey();
+                freshAccount = true;
+                File.WriteAllText(keyFile, accountKey);
+            }
+        }
+
+        private static string GenerateKey()
+        {
+            byte[] bytes = new byte[32];
+            using (RandomNumberGenerator rng = RandomNumberGenerator.Create())
+            {
+                rng.GetBytes(bytes);
+            }
+            StringBuilder sb = new StringBuilder(64);
+            for (int i = 0; i < bytes.Length; i++)
+            {
+                sb.Append(bytes[i].ToString("x2"));
+            }
+            return sb.ToString();
+        }
+
+        /// <summary>端口上已有服务就直接复用；否则启动内置后端并等它就绪。</summary>
+        private void StartBackendIfNeeded()
+        {
+            if (IsServerUp())
+            {
+                ownsBackend = false;
+                return;
+            }
+
+            string baseDir = AppDomain.CurrentDomain.BaseDirectory;
+            string java = Path.Combine(baseDir, Path.Combine("runtime", Path.Combine("bin", "javaw.exe")));
+            string jar = Path.Combine(baseDir, Path.Combine("app", "timetable-backend.jar"));
+            if (!File.Exists(java) || !File.Exists(jar))
+            {
+                throw new FileNotFoundException(
+                    "安装不完整：缺少 runtime\\bin\\javaw.exe 或 app\\timetable-backend.jar。\r\n"
+                    + "请重新解压完整的安装目录后运行。");
+            }
+
+            string args = "-jar \"" + jar + "\""
+                + " --spring.profiles.active=standalone"
+                + " --app.data-dir=\"" + dataDir.Replace('\\', '/') + "\""
+                + " --app.bootstrap-key=" + accountKey
+                + " --server.port=" + Program.Port;
+
+            ProcessStartInfo psi = new ProcessStartInfo(java, args);
+            psi.UseShellExecute = false;
+            psi.CreateNoWindow = true;
+            psi.WorkingDirectory = baseDir;
+
+            backend = Process.Start(psi);
+            ownsBackend = true;
+            // 外壳被强杀时，靠 Job Object 让系统一并回收后端进程
+            job = new JobObject();
+            job.AddProcess(backend.Handle);
+
+            WaitForServer();
+        }
+
+        private void WaitForServer()
+        {
+            DateTime deadline = DateTime.UtcNow.AddSeconds(90);
+            while (DateTime.UtcNow < deadline)
+            {
+                if (backend != null && backend.HasExited)
+                {
+                    throw new InvalidOperationException(
+                        "后端进程意外退出（退出码 " + backend.ExitCode + "）。\r\n日志："
+                        + Path.Combine(dataDir, Path.Combine("logs", "timetable.log")));
+                }
+                if (IsServerUp())
+                {
+                    return;
+                }
+                Thread.Sleep(300);
+            }
+            throw new TimeoutException(
+                "后端启动超时。\r\n日志：" + Path.Combine(dataDir, Path.Combine("logs", "timetable.log")));
+        }
+
+        /// <summary>能拿到任何 HTTP 响应（含 401/404）都说明服务已监听。</summary>
+        private static bool IsServerUp()
+        {
+            try
+            {
+                HttpWebRequest req = (HttpWebRequest)WebRequest.Create("http://127.0.0.1:" + Program.Port + "/");
+                req.Method = "GET";
+                req.Timeout = 2000;
+                using (HttpWebResponse resp = (HttpWebResponse)req.GetResponse())
+                {
+                    return true;
+                }
+            }
+            catch (WebException ex)
+            {
+                return ex.Response != null;
+            }
+            catch (Exception)
+            {
+                return false;
+            }
+        }
+
+        private async void InitWebView()
+        {
+            try
+            {
+                string userDataFolder = Path.Combine(dataDir, "webview2");
+                Directory.CreateDirectory(userDataFolder);
+                CoreWebView2Environment env =
+                    await CoreWebView2Environment.CreateAsync(null, userDataFolder, null);
+                await this.webView.EnsureCoreWebView2Async(env);
+
+                CoreWebView2Settings settings = this.webView.CoreWebView2.Settings;
+                settings.AreDefaultContextMenusEnabled = false;
+                settings.IsStatusBarEnabled = false;
+                settings.IsZoomControlEnabled = true;
+
+                // 自动登录：在文档创建前写入前端读取的那两个 localStorage 键
+                string script =
+                    "try{"
+                    + "localStorage.setItem('timetable.apiKey','" + accountKey + "');"
+                    + "localStorage.setItem('timetable.apiLabel','管理员');"
+                    + "}catch(e){}";
+                await this.webView.CoreWebView2.AddScriptToExecuteOnDocumentCreatedAsync(script);
+
+                this.webView.Source = new Uri("http://127.0.0.1:" + Program.Port + "/");
+            }
+            catch (Exception ex)
+            {
+                MessageBox.Show(
+                    "无法初始化 WebView2 组件：\r\n\r\n" + ex.Message
+                    + "\r\n\r\n请先安装 Microsoft Edge WebView2 Runtime（Win10/11 通常已自带）。",
+                    "大切课程表", MessageBoxButtons.OK, MessageBoxIcon.Error);
+                Close();
+            }
+        }
+
+        /// <summary>首次运行时把本机账号 Key 显示一次，便于在其它设备（小组件/手机）使用。</summary>
+        protected override void OnShown(EventArgs e)
+        {
+            base.OnShown(e);
+            if (!freshAccount)
+            {
+                return;
+            }
+            bool copied = false;
+            try
+            {
+                Clipboard.SetText(accountKey);
+                copied = true;
+            }
+            catch (Exception)
+            {
+                // 剪贴板被其它程序占用时不阻断启动
+            }
+            MessageBox.Show(
+                "已为你创建本机账号，并已自动登录，无需手动输入。\r\n\r\n"
+                + "如需在其它设备（iPad/手机小组件、其它浏览器）使用，API Key 为：\r\n\r\n"
+                + accountKey
+                + (copied ? "\r\n\r\n（已复制到剪贴板）" : "")
+                + "\r\n\r\n该 Key 也保存在：" + keyFile,
+                "大切课程表 - 首次运行", MessageBoxButtons.OK, MessageBoxIcon.Information);
+        }
+
+        protected override void OnFormClosing(FormClosingEventArgs e)
+        {
+            try
+            {
+                if (ownsBackend && backend != null && !backend.HasExited)
+                {
+                    backend.Kill();
+                    backend.WaitForExit(5000);
+                }
+            }
+            catch (Exception)
+            {
+                // 关窗阶段的清理失败无需打扰用户；Job Object 仍会兜底回收
+            }
+            if (job != null)
+            {
+                job.Dispose();
+                job = null;
+            }
+            base.OnFormClosing(e);
+        }
+    }
+
+    /// <summary>
+    /// 最小化的 Windows Job Object 封装：设置 KILL_ON_JOB_CLOSE，句柄随外壳进程关闭时
+    /// 由系统结束 job 内所有进程，避免外壳崩溃后残留 javaw.exe 占着端口。
+    /// </summary>
+    internal sealed class JobObject : IDisposable
+    {
+        private const int JobObjectExtendedLimitInformation = 9;
+        private const uint JobObjectLimitKillOnJobClose = 0x2000;
+
+        [DllImport("kernel32.dll", CharSet = CharSet.Unicode)]
+        private static extern IntPtr CreateJobObject(IntPtr attributes, string name);
+
+        [DllImport("kernel32.dll")]
+        private static extern bool SetInformationJobObject(IntPtr job, int infoType, IntPtr info, uint length);
+
+        [DllImport("kernel32.dll", SetLastError = true)]
+        private static extern bool AssignProcessToJobObject(IntPtr job, IntPtr process);
+
+        [DllImport("kernel32.dll", SetLastError = true)]
+        private static extern bool CloseHandle(IntPtr handle);
+
+        [StructLayout(LayoutKind.Sequential)]
+        private struct IoCounters
+        {
+            public ulong ReadOperationCount;
+            public ulong WriteOperationCount;
+            public ulong OtherOperationCount;
+            public ulong ReadTransferCount;
+            public ulong WriteTransferCount;
+            public ulong OtherTransferCount;
+        }
+
+        [StructLayout(LayoutKind.Sequential)]
+        private struct BasicLimitInformation
+        {
+            public long PerProcessUserTimeLimit;
+            public long PerJobUserTimeLimit;
+            public uint LimitFlags;
+            public UIntPtr MinimumWorkingSetSize;
+            public UIntPtr MaximumWorkingSetSize;
+            public uint ActiveProcessLimit;
+            public UIntPtr Affinity;
+            public uint PriorityClass;
+            public uint SchedulingClass;
+        }
+
+        [StructLayout(LayoutKind.Sequential)]
+        private struct ExtendedLimitInformation
+        {
+            public BasicLimitInformation BasicLimitInformation;
+            public IoCounters IoInfo;
+            public UIntPtr ProcessMemoryLimit;
+            public UIntPtr JobMemoryLimit;
+            public UIntPtr PeakProcessMemoryUsed;
+            public UIntPtr PeakJobMemoryUsed;
+        }
+
+        private IntPtr handle;
+
+        internal JobObject()
+        {
+            handle = CreateJobObject(IntPtr.Zero, null);
+            if (handle == IntPtr.Zero)
+            {
+                return;
+            }
+            ExtendedLimitInformation info = new ExtendedLimitInformation();
+            info.BasicLimitInformation.LimitFlags = JobObjectLimitKillOnJobClose;
+            int size = Marshal.SizeOf(typeof(ExtendedLimitInformation));
+            IntPtr buffer = Marshal.AllocHGlobal(size);
+            try
+            {
+                Marshal.StructureToPtr(info, buffer, false);
+                SetInformationJobObject(handle, JobObjectExtendedLimitInformation, buffer, (uint)size);
+            }
+            finally
+            {
+                Marshal.FreeHGlobal(buffer);
+            }
+        }
+
+        internal void AddProcess(IntPtr processHandle)
+        {
+            if (handle != IntPtr.Zero && processHandle != IntPtr.Zero)
+            {
+                AssignProcessToJobObject(handle, processHandle);
+            }
+        }
+
+        public void Dispose()
+        {
+            if (handle != IntPtr.Zero)
+            {
+                CloseHandle(handle);
+                handle = IntPtr.Zero;
+            }
+        }
+    }
+}

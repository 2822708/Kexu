+        var result = run("function shouldTrigger(ctx){"
+                + " var s = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!';"
+                + " return /(a+)+$/.test(s); }");

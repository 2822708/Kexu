# ============================================================
#  环境变量示例
#  复制/参考此文件配置本地环境；真实值请勿提交到仓库。
#  后端本地开发可在 ~/.zshrc 或 backend/src/main/resources/application-local.yml 中配置。
# ============================================================

# --- 数据库 ---
# MySQL 密码（application.yml 读取 `${KEXU_COMMON_PASSWORD:}`）
KEXU_COMMON_PASSWORD=your-db-password

# --- AI（DeepSeek）---
# 未配置时 /api/ai/status 返回 enabled=false，AI 功能自动禁用，其余功能正常
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选：
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# --- 部署（仅 docs/DEPLOYMENT.md 使用，代码不读取）---
# KEXU_SERVER_IP=your-server-ip

# --- Kexu desktop/standalone (optional) ---
# KEXU_DATA_DIR=E:/Kexu/Data
# KEXU_PORT=17817
# KEXU_BOOTSTRAP_KEY=your-admin-key
# KEXU_SETTINGS_ENCRYPTION_KEY=your-local-encryption-key

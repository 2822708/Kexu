<?xml version="1.0" encoding="utf-8"?>
<!--
  随 exe 一起发布的运行时配置（构建脚本会把它复制成 Kexu.exe.config）。

  .NET Framework 4.7+ 的 WinForms 需要这个开关才会按 PerMonitorV2 处理 DPI 变化；
  与 app.manifest 里的 dpiAwareness 配合使用。
-->
<configuration>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>

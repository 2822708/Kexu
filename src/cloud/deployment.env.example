PORT=9001
SNAPSHOT_DATA_DIR=/srv/kexu/private-snapshots
SNAPSHOT_ALLOWED_ORIGIN=https://your-timetable.example.com
# Initial shared-server limits: 256 MiB overall, 32 MiB per vault, at most 16 vaults.
SNAPSHOT_MAX_TOTAL_BYTES=268435456
SNAPSHOT_MAX_VAULT_BYTES=33554432
SNAPSHOT_MAX_SNAPSHOT_BYTES=10485760
SNAPSHOT_MAX_SNAPSHOTS=20
SNAPSHOT_MAX_VAULTS=16
SNAPSHOT_REQUESTS_PER_MINUTE=120
# Behind nginx the connection IP is loopback; this is intentionally a site-wide safety cap.
SNAPSHOT_REGISTRATIONS_PER_DAY=3

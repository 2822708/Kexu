{
  "name": "timetable-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "大切课程表 · 课程表与待办 Web 前端",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tangent0712/Tangent-Timetable.git",
    "directory": "frontend"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "build:shell": "tsc -b && vite build --mode shell --outDir dist-shell",
    "typecheck": "tsc --noEmit",
    "test:device-session": "node --test scripts/test-device-session.mjs",
    "test:pwa": "node --test scripts/test-pwa.mjs",
    "test:day-agenda": "node --test scripts/test-day-agenda.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test:local-core": "node --test scripts/test-local-core.mjs",
    "test:snapshots": "node --test scripts/test-snapshots.mjs",
    "test:local-ai": "node --test scripts/test-local-ai.mjs",
    "mock:ai": "node scripts/mock-openai.mjs",
    "eval:ai": "node scripts/eval-local-ai.mjs",
    "test:local": "node --test scripts/test-local-core.mjs scripts/test-snapshots.mjs scripts/test-local-ai.mjs scripts/test-daily-core.mjs scripts/test-daily-review.mjs",
    "test:daily": "node --test scripts/test-daily-core.mjs scripts/test-daily-review.mjs",
    "test:shell": "node --test scripts/test-native-export.mjs",
    "test:timetable-layout": "node --test scripts/test-timetable-layout.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.21.6",
    "dayjs": "^1.11.13",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "5.4.449",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.10"
  }
}

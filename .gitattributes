* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve the upstream CRLF blob without normalization-induced dirty status.
src/backend/mvnw.cmd -text

# Historical handoff files are retained byte-for-byte, including patch context.
docs/archive/** -text

# Shell / 包装脚本强制 LF
*.sh text eol=lf
mvnw text eol=lf

# 二进制文件
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
